  m_Script: {fileID: 11500000, guid: fc04ea13dd28af5498af365f6c19c47f, type: 3}
  m_Name: 04_LightsOut2_ND
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.Data.NormalDialogueSO
  lines:
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`WTF! |.|.|.|You scared me half to death.'
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: Maid
    characterPortrait: {fileID: 21300000, guid: afa0124e800babe4a88c31dcddd0cdcf, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: ed2c8205fb0e38a46a9ea054ec01bb28, type: 3}
    text: '`I''m sorry for startling you. '
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: Maid
    characterPortrait: {fileID: 21300000, guid: afa0124e800babe4a88c31dcddd0cdcf, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: ed2c8205fb0e38a46a9ea054ec01bb28, type: 3}
    text: '`I just came to check up on you. '
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`Everything''s ||| fine. '
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`What is going on with the lights? '
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: Maid
    characterPortrait: {fileID: 21300000, guid: afa0124e800babe4a88c31dcddd0cdcf, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: ed2c8205fb0e38a46a9ea054ec01bb28, type: 3}
    text: "`This area is prone to blackouts. Nothing to worry \n``about."
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: Maid
    characterPortrait: {fileID: 21300000, guid: afa0124e800babe4a88c31dcddd0cdcf, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: ed2c8205fb0e38a46a9ea054ec01bb28, type: 3}
    text: '`The lights should turn back on any minute now.'
    typeSpeed: 0.05
    onLineStart:
      events:
      - rid: 6929337907100778738
      - rid: 6929337907100778739
      - rid: 6929337907100778740
    onLineEnd:
      events: []
  - characterName: Maid
    characterPortrait: {fileID: 21300000, guid: afa0124e800babe4a88c31dcddd0cdcf, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: ed2c8205fb0e38a46a9ea054ec01bb28, type: 3}
    text: '`There they are.'
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: Maid
    characterPortrait: {fileID: 21300000, guid: afa0124e800babe4a88c31dcddd0cdcf, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: ed2c8205fb0e38a46a9ea054ec01bb28, type: 3}
    text: '``Now if you''ll excuse me I have to get back

      `to work. '
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`(And just like that she''s off.)'
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`(Kinda strange how she was just standing

      ```there just as the
      lights went out.)'
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`(Probably just a coincidence.)'
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  onDialogueComplete:
    events:
    - rid: 6929337907100778743
