  m_Script: {fileID: 11500000, guid: fc04ea13dd28af5498af365f6c19c47f, type: 3}
  m_Name: 00_OutsideStreetIntroBegin_ND
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.Data.NormalDialogueSO
  lines:
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`Sigh|.|.|.| I''ve already missed the last train home|.|.|.|'
    typeSpeed: 0.05
    onLineStart:
      events:
      - rid: 2168746681146016153
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`I really shouldn''t be spending my nights like this.'
    typeSpeed: 0.05
    onLineStart:
      events:
      - rid: 2168746681146016153
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`This time last year I was a fresh graduate

      ```determined and looking
      forward to the future.'
    typeSpeed: 0.05
    onLineStart:
      events:
      - rid: 2168746681146016153
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`Look at me now|.|.|.|.|.|'
    typeSpeed: 0.05
    onLineStart:
      events:
      - rid: 2168746681146016153
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`Aimlessly roaming the streets looking for

      ```anything interseting
      to do.'
    typeSpeed: 0.05
    onLineStart:
      events:
      - rid: 2168746681146016153
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`Well.| I guess there is no point in moping around

      ```talking to
      myself. '
    typeSpeed: 0.05
    onLineStart:
      events:
      - rid: 2168746681146016153
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: "`I saw a flyer for an internet caf\xE9 a few streets\n```back. "
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events: []
  - characterName: You
    characterPortrait: {fileID: 21300000, guid: 1a133b06bbc35444dba2302c28c4f961, type: 3}
    characterPortraitBackground: {fileID: 21300000, guid: 296cc3a1ba1f3364c8b4190a7f355d26, type: 3}
    text: '`That should be a good place to spend the night. '
    typeSpeed: 0.05
    onLineStart:
      events: []
    onLineEnd:
      events:
      - rid: 2168746681146016201
  onDialogueComplete:
    events: []
